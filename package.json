{
  "name": "code-compare",
  "version": "0.1.0",
  "description": "A fast, private folder and text comparison tool for macOS and Windows.",
  "private": true,
  "main": "./out/main/main.js",
  "author": "Code Compare contributors",
  "license": "MIT",
  "homepage": "https://github.com/csoss/code-compare#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csoss/code-compare.git"
  },
  "bugs": {
    "url": "https://github.com/csoss/code-compare/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.codecompare.desktop",
    "productName": "Code Compare",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
